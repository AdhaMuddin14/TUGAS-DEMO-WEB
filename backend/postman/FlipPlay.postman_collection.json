    {
      "name": "Cleanup",
      "description": "Jalankan setelah pengujian collection selesai. Menghapus media uji yang dibuat oleh request Create Media.",
      "item": [
        {
          "name": "Delete Test Media",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('created_media_id')) {",
                  "    pm.execution.skipRequest();",
                  "}"
                ]
