    "name": "FlipPlay API",
    "description": "Koleksi pengujian seluruh endpoint API FlipPlay. Jalankan php artisan db:seed agar Test User tersedia (user_id=1), atau atur user_id ke ID pengguna yang valid. Request Create Media menyimpan ID media baru ke variabel media_id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "media_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "created_media_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "search_title",
      "value": "Avengers",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Media CRUD",
      "item": [
        {
          "name": "1. List Media",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/media",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "media"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains a data array', function () {",
                  "    pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Create Media",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"FlipPlay Postman Test {{$timestamp}}\",\n  \"type\": \"Film\",\n  \"description\": \"Media untuk pengujian API\",\n  \"cover\": \"postman-test.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/media",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "media"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Response contains the created media ID', function () {",
                  "    pm.expect(body.data.id).to.exist;",
                  "});",
                  "pm.collectionVariables.set('media_id', String(body.data.id));",
                  "pm.collectionVariables.set('created_media_id', String(body.data.id));",
                  "pm.collectionVariables.set('search_title', body.data.title);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search Media by Title",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/media?search={{search_title}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "media"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "{{search_title}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Search returns matching media', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const title = pm.collectionVariables.get('search_title').toLowerCase();",
                  "    const results = pm.response.json().data;",
                  "    pm.expect(results).to.be.an('array');",
                  "    pm.expect(results.some((media) => media.title.toLowerCase() === title)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Show Media",
