          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains the requested media', function () {",
                  "    const media = pm.response.json().data;",
                  "    pm.expect(media.id).to.exist;",
                  "    pm.expect(media.title).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
